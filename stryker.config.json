{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --bail 1"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.{test,spec}.ts",
    "!src/index.ts",
    "!src/env.ts",
    "!src/db/**"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "incremental": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
