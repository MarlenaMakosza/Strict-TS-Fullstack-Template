{
  "name": "ts-project",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc --project tsconfig.build.json && npm run css:build",
    "css:build": "tailwindcss --input src/styles/app.css --output dist/app.css --minify",
    "css:watch": "tailwindcss --input src/styles/app.css --output dist/app.css --watch",
    "start": "node dist/index.js",
    "prepare": "husky",
    "validate": "npm run lint && npm run ts-check && npm run spellcheck && npm run knip && npm run test:coverage && npm run quality:crap && npm run quality:duplication && npm run check:adrs",
    "validate:full": "npm run validate && npm run security:audit && npm run test:integration && npm run test:mutation -- --force && npm run test:e2e && npm run docs:build",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write --cache --log-level warn",
    "format:check": "prettier . --check",
    "autofix": "npm run lint:fix && npm run format",
    "ts-check": "tsc --noEmit",
    "spellcheck": "cspell --no-progress --dot \"**/*.{js,ts,cjs,mjs,json,md,yml,yaml,css}\"",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:unit:watch": "vitest tests/unit",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:open": "bddgen && playwright test --ui",
    "quality:crap": "node dev/quality/crap.ts",
    "quality:duplication": "jscpd --no-tips",
    "commitlint": "commitlint --edit",
    "check:adrs": "archgate check",
    "docs:api": "typedoc --options typedoc.public.json && typedoc --options typedoc.internal.json",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "db:start": "docker compose up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dev/db/migrate.ts",
    "db:sync": "npm run db:generate && npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "seed:dev": "node dev/db/seed.ts",
    "example:logger": "node dev/logger-example.ts",
    "firstrun:dev": "npm install && npm run ts-check && docker compose up --detach --wait && npm run db:sync && npm run seed:dev",
    "list-outdated-dependencies": "npm-check-updates --format repo,group --peer",
    "update-dependencies": "npm run list-outdated-dependencies -- -u && npm install && npm update && npm dedupe && npm run autofix",
    "clean": "rimraf node_modules dist coverage reports .stryker-tmp"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-pl_pl": "^3.0.7",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "archgate": "^0.59.0",
    "cspell": "^10.3.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^77.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "pino-pretty": "^13.2.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tailwind-csstree": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,md,css}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "cspell --no-progress --no-must-find-files"
    ],
    "!(package-lock).json": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "cspell --no-progress --no-must-find-files"
    ],
    "*.{yml,yaml}": [
      "prettier --write",
      "cspell --no-progress --no-must-find-files"
    ]
  }
}
