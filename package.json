{
  "name": "ts-project",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w apps/api",
    "prepare": "husky",
    "validate": "npm run lint && npm run ts-check && npm run spellcheck && npm run knip && npm run test:coverage && npm run quality:crap && npm run quality:duplication && npm run quality:one-react && npm run check:adrs",
    "validate:full": "npm run validate && npm run security:audit && npm run test:integration && npm run test:mutation -- --force && npm run test:e2e && npm run build && npm run docs:api && npm run docs:build",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write --cache --log-level warn",
    "format:check": "prettier . --check",
    "autofix": "npm run lint:fix && npm run format",
    "ts-check": "tsc --noEmit && npm run ts-check --workspaces --if-present",
    "spellcheck": "cspell --no-progress --dot \"**/*.{js,ts,tsx,html,cjs,mjs,json,md,yml,yaml,css}\"",
    "knip": "knip",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:coverage": "vitest run && npm run test:coverage --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:mutation": "npm run test:mutation --workspaces --if-present --",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:open": "bddgen && playwright test --ui",
    "quality:crap": "npm run quality:crap --workspaces --if-present",
    "quality:duplication": "jscpd --no-tips",
    "commitlint": "commitlint --edit",
    "check:adrs": "archgate check",
    "docs:api": "typedoc --options typedoc.public.json && typedoc --options typedoc.internal.json",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "db:start": "npm run db:start -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:sync": "npm run db:sync -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "db:check": "npm run db:check -w apps/api",
    "seed:dev": "npm run seed:dev -w apps/api",
    "example:logger": "npm run example:logger -w apps/api",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "firstrun:dev": "npm install && npx playwright install chromium && npm run ts-check && npm run firstrun:dev -w apps/api",
    "list-outdated-dependencies": "npm-check-updates --format repo,group --peer --workspaces --root",
    "update-dependencies": "npm run list-outdated-dependencies -- -u && npm install && npm update && npm dedupe && npm run autofix",
    "clean": "rimraf node_modules dist coverage reports .stryker-tmp \"apps/*/{node_modules,dist,coverage,reports,.stryker-tmp}\"",
    "quality:one-react": "node dev/quality/one-version.ts react react-dom"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-pl_pl": "^3.0.7",
    "@dword-design/eslint-plugin-import-alias": "^8.1.8",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint-react/eslint-plugin": "^5.28.1",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "archgate": "^0.59.0",
    "concurrently": "^10.0.6",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "tailwind-csstree": "^0.4.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,md,css,html}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "cspell --no-progress --no-must-find-files"
    ],
    "!(package-lock).json": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "cspell --no-progress --no-must-find-files"
    ],
    "*.{yml,yaml}": [
      "prettier --write",
      "cspell --no-progress --no-must-find-files"
    ]
  }
}
