{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["dev/**/*.ts", "tests/e2e/steps/**/*.ts"],
      "project": ["dev/**/*.ts", "tests/**/*.ts"]
    },
    "apps/api": {
      "entry": ["dev/**/*.ts"],
      "project": ["src/**/*.ts", "dev/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["@stryker-mutator/command-runner", "pino-pretty"]
    }
  }
}
