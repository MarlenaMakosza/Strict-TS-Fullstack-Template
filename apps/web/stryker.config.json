{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --bail 1"
  },
  "coverageAnalysis": "off",
  "mutate": ["src/**/*.{ts,tsx}", "!src/main.tsx"],
  "reporters": ["clear-text", "progress", "html"],
  "incremental": true,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
